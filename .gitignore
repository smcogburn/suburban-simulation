# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.env

# Data (large files, download separately)
data/osm/*.pbf
data/gtfs/**/*.zip
data/mdotmta_gtfs_localbus/

# r5py / osmnx cache (can be hundreds of MB, fully regenerable)
cache/

# Generated outputs
outputs/
*.png

# Ignore standalone HTML prototypes but keep the visualization
*.html
!visualization/index.html

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp

# Keep directory structure
!data/osm/.gitkeep
!data/gtfs/baseline/.gitkeep
!data/gtfs/doubled/.gitkeep
!data/export/.gitkeep
!outputs/.gitkeep
